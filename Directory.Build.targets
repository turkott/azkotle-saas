<Project>
  <!--
    Husky.Net auto-install only from the repo root (where this file lives).
    Runs once per build, not once per project. HUSKY=0 skips in CI.
  -->
  <Target Name="husky" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(HUSKY)' != '0' AND '$(IsCrossTargetingBuild)' != 'true' AND '$(MSBuildProjectFullPath)' != ''">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          ContinueOnError="true" />
    <Exec Command="dotnet husky install"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          ContinueOnError="true" />
  </Target>
</Project>
