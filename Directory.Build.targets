<Project>
  <!--
    Husky.Net auto-install only from the repo root (where this file lives).
    Self-skips when CI=true or when .git is absent (Docker build context).
    HUSKY=0 remains as a manual override.
  -->
  <Target Name="husky" BeforeTargets="Restore;CollectPackageReferences"
          Condition="'$(HUSKY)' != '0' AND '$(CI)' != 'true' AND Exists('$(MSBuildThisFileDirectory).git') AND '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="dotnet tool restore"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          ContinueOnError="true" />
    <Exec Command="dotnet husky install"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          StandardOutputImportance="Low"
          StandardErrorImportance="High"
          ContinueOnError="true" />
  </Target>
</Project>
