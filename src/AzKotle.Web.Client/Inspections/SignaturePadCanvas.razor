@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="azk-signature-pad" style="border: 1px solid var(--mud-palette-lines-default); border-radius: 6px; background: white;">
    <canvas id="@_canvasId" style="display: block; width: 100%; height: @(Height)px; touch-action: none; cursor: crosshair;"></canvas>
    <MudStack Row Class="pa-2" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption" Color="Color.Secondary">Podepiš se prstem nebo myší.</MudText>
        <MudSpacer />
        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="ClearAsync" Disabled="_disposed">
            Vymazat
        </MudButton>
    </MudStack>
</div>

@code {
    [Parameter] public int Height { get; set; } = 200;

    private readonly string _canvasId = $"sigpad-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/signature-pad.js");
                await _module.InvokeVoidAsync("init", _canvasId);
            }
            catch (JSException)
            {
                // Module load failed — leave canvas inert; parent shows fallback.
                _module = null;
            }
        }
    }

    public async Task ClearAsync()
    {
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("clear", _canvasId);
        }
        catch (JSDisconnectedException) { }
    }

    public async Task<bool> IsEmptyAsync()
    {
        if (_module is null) return true;
        try
        {
            return await _module.InvokeAsync<bool>("isEmpty", _canvasId);
        }
        catch (JSDisconnectedException)
        {
            return true;
        }
    }

    public async Task<string?> GetPngBase64Async()
    {
        if (_module is null) return null;
        try
        {
            var dataUrl = await _module.InvokeAsync<string?>("getDataUrl", _canvasId);
            if (string.IsNullOrEmpty(dataUrl)) return null;
            var commaIdx = dataUrl.IndexOf(',');
            return commaIdx > 0 ? dataUrl[(commaIdx + 1)..] : null;
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _canvasId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { }
        }
    }
}
