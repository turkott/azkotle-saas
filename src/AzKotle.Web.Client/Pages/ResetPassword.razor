@page "/reset-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using AzKotle.Application.Auth
@using AzKotle.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject AuthApiClient AuthClient
@inject NavigationManager Navigation

<PageTitle>Nastavení nového hesla · AZ KOTLE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-2" Align="Align.Center">Nové heslo</MudText>

        @if (_done)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Heslo bylo nastaveno. Můžete se přihlásit s novým heslem.
            </MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" FullWidth>
                Přejít na přihlášení
            </MudButton>
        }
        else if (_invalidLink)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">
                Reset odkaz je neplatný. Vyžádejte si nový přes <MudLink Href="/forgot-password">Zapomenuté heslo</MudLink>.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mb-4" Align="Align.Center" Color="Color.Secondary">
                Zadejte nové heslo k vašemu účtu.
            </MudText>

            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_model.NewPassword"
                                  Label="Nové heslo (min. 12 znaků)"
                                  InputType="InputType.Password"
                                  Required
                                  Disabled="_busy"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="_model.ConfirmPassword"
                                  Label="Heslo znovu"
                                  InputType="InputType.Password"
                                  Required
                                  Disabled="_busy"
                                  Variant="Variant.Outlined" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense>@_error</MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth
                               Disabled="_busy">
                        @if (_busy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate />
                        }
                        else
                        {
                            <span>Nastavit heslo</span>
                        }
                    </MudButton>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private readonly ResetModel _model = new();
    private bool _busy;
    private bool _done;
    private bool _invalidLink;
    private string? _error;
    private string? _token;
    private string? _slug;

    protected override void OnInitialized()
    {
        // Token + slug čteme z query stringu — server je tam dostal v emailovém
        // linku. Bez obou nelze pokračovat (RLS lookup vyžaduje tenant kontext).
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = uri.Query.TrimStart('?');
        foreach (var pair in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var idx = pair.IndexOf('=');
            if (idx <= 0) continue;
            var key = Uri.UnescapeDataString(pair[..idx]);
            var value = Uri.UnescapeDataString(pair[(idx + 1)..]);
            if (key == "token") _token = value;
            else if (key == "slug") _slug = value;
        }

        if (string.IsNullOrWhiteSpace(_token) || string.IsNullOrWhiteSpace(_slug))
        {
            _invalidLink = true;
        }
    }

    private async Task SubmitAsync()
    {
        if (_token is null || _slug is null)
        {
            _invalidLink = true;
            return;
        }

        if (!string.Equals(_model.NewPassword, _model.ConfirmPassword, StringComparison.Ordinal))
        {
            _error = "Hesla se neshodují.";
            return;
        }

        _busy = true;
        _error = null;
        StateHasChanged();

        try
        {
            var request = new ResetPasswordRequest(
                Token: _token,
                TenantSlug: _slug,
                NewPassword: _model.NewPassword);

            var result = await AuthClient.ResetPasswordAsync(request);
            if (!result.Succeeded)
            {
                _error = result.Error ?? "Nepodařilo se nastavit nové heslo.";
                return;
            }

            _done = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ResetModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
