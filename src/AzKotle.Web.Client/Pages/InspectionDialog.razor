<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudDatePicker @bind-Date="_model.PerformedAt" Label="Datum revize" Variant="Variant.Outlined" />
            <MudDatePicker @bind-Date="_model.NextDueAt" Label="Další termín" Variant="Variant.Outlined"
                           HelperText="Standardně 1 rok od aktuální revize." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Zrušit</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Zaznamenat</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private InspectionFormData _model = new();

    private void Submit()
    {
        if (!_model.PerformedAt.HasValue)
        {
            Snackbar.Add("Vyplň datum revize.", Severity.Warning);
            return;
        }
        if (_model.NextDueAt.HasValue && _model.NextDueAt.Value <= _model.PerformedAt.Value)
        {
            Snackbar.Add("Další termín musí být po revizi.", Severity.Warning);
            return;
        }
        MudDialog.Close(DialogResult.Ok(_model));
    }

    private void Cancel() => MudDialog.Cancel();
}
