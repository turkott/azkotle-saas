@page "/forgot-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using AzKotle.Application.Auth
@using AzKotle.Web.Client.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject AuthApiClient AuthClient
@inject NavigationManager Navigation

<PageTitle>Zapomenuté heslo · AZ KOTLE</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
    <MudPaper Elevation="2" Class="pa-6">
        <MudText Typo="Typo.h4" Class="mb-2" Align="Align.Center">Zapomenuté heslo</MudText>
        <MudText Typo="Typo.body2" Class="mb-4" Align="Align.Center" Color="Color.Secondary">
            Pošleme vám odkaz pro nastavení nového hesla.
        </MudText>

        @if (_submitted)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                Pokud účet existuje, odeslali jsme na něj odkaz pro reset hesla.
                Zkontrolujte schránku (i složku Spam). Odkaz je platný 1 hodinu.
            </MudAlert>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/login" FullWidth>
                Zpět na přihlášení
            </MudButton>
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="SubmitAsync">
                <DataAnnotationsValidator />
                <MudStack Spacing="3">
                    <MudTextField @bind-Value="_model.Email"
                                  Label="Email"
                                  InputType="InputType.Email"
                                  Required
                                  Disabled="_busy"
                                  Variant="Variant.Outlined" />

                    <MudTextField @bind-Value="_model.TenantSlug"
                                  Label="Slug firmy"
                                  HelperText="Najdete v subdoméně {slug}.az-kotle.cz nebo v emailech od nás."
                                  Required
                                  Disabled="_busy"
                                  Variant="Variant.Outlined" />

                    @if (_error is not null)
                    {
                        <MudAlert Severity="Severity.Error" Dense>@_error</MudAlert>
                    }

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth
                               Disabled="_busy">
                        @if (_busy)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate />
                        }
                        else
                        {
                            <span>Odeslat odkaz</span>
                        }
                    </MudButton>

                    <MudText Typo="Typo.body2" Align="Align.Center">
                        <MudLink Href="/login">Zpět na přihlášení</MudLink>
                    </MudText>
                </MudStack>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    private readonly ForgotModel _model = new();
    private bool _busy;
    private bool _submitted;
    private string? _error;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        StateHasChanged();

        try
        {
            var request = new ForgotPasswordRequest(
                Email: _model.Email.Trim(),
                TenantSlug: _model.TenantSlug.Trim());

            var result = await AuthClient.ForgotPasswordAsync(request);
            if (!result.Succeeded)
            {
                _error = result.Error ?? "Nepodařilo se odeslat žádost.";
                return;
            }

            _submitted = true;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class ForgotModel
    {
        public string Email { get; set; } = string.Empty;
        public string TenantSlug { get; set; } = string.Empty;
    }
}
