<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- Production safety: .NET 10 SDK pulls Microsoft.DotNet.HotReload.WebAssembly.Browser
         into release WASM bundles by default. In production it tries to open a WebSocket
         to a non-existent dev hot-reload endpoint, which can stall Blazor bootstrap and
         leave pages blank after the shell loads. These flags exclude it from any build. -->
    <WasmEnableHotReload>false</WasmEnableHotReload>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MudBlazor" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzKotle.Shared\AzKotle.Shared.csproj" />
    <ProjectReference Include="..\AzKotle.Application\AzKotle.Application.csproj" />
  </ItemGroup>

</Project>
