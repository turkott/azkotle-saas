# syntax=docker/dockerfile:1.7
# Multi-stage build for AzKotle.Api (.NET 10).
# Build context: repo root.
#
# Build:   docker build -f deploy/Dockerfile.api -t azkotle-api .
# Run:     docker run --rm -p 8080:8080 azkotle-api

ARG DOTNET_VERSION=10.0
ARG ALPINE_VARIANT=alpine

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION}-${ALPINE_VARIANT} AS build
WORKDIR /src

# Restore: copy only projects + props files first for better layer caching.
COPY Directory.Packages.props Directory.Build.props NuGet.config* ./
COPY src/AzKotle.Domain/AzKotle.Domain.csproj         src/AzKotle.Domain/
COPY src/AzKotle.Application/AzKotle.Application.csproj src/AzKotle.Application/
COPY src/AzKotle.Infrastructure/AzKotle.Infrastructure.csproj src/AzKotle.Infrastructure/
COPY src/AzKotle.Api/AzKotle.Api.csproj                src/AzKotle.Api/
COPY src/AzKotle.Shared/AzKotle.Shared.csproj          src/AzKotle.Shared/
RUN dotnet restore src/AzKotle.Api/AzKotle.Api.csproj --runtime linux-musl-x64

# Build + publish.
COPY src/AzKotle.Domain/         src/AzKotle.Domain/
COPY src/AzKotle.Application/    src/AzKotle.Application/
COPY src/AzKotle.Infrastructure/ src/AzKotle.Infrastructure/
COPY src/AzKotle.Api/            src/AzKotle.Api/
COPY src/AzKotle.Shared/         src/AzKotle.Shared/
RUN dotnet publish src/AzKotle.Api/AzKotle.Api.csproj \
    -c Release \
    --no-restore \
    --runtime linux-musl-x64 \
    --self-contained false \
    -p:PublishReadyToRun=false \
    -o /app/publish

# Final runtime image.
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION}-${ALPINE_VARIANT} AS runtime
RUN apk add --no-cache curl tzdata icu-libs \
    && addgroup -S azkotle \
    && adduser -S azkotle -G azkotle -u 10001
ENV TZ=Europe/Prague \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production

WORKDIR /app
COPY --from=build --chown=azkotle:azkotle /app/publish ./
USER azkotle
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "AzKotle.Api.dll"]
