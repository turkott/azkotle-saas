# Šablona pro production .env soubor na VPS.
# Zkopíruj jako .env.prod a vyplň skutečné hodnoty.
# NIKDY tento soubor (.env.prod) necommituj — drž ho jen na VPS.

# --- Postgres ---
# POSTGRES_USER je SUPERUSER vytvořený postgres image — používá se pro:
#   (a) migrace (dotnet ef database update musí mít DDL práva),
#   (b) postgres-backup sidecar (pg_dump potřebuje plný přístup),
#   (c) bootstrap role azkotle_app (init script/apply-app-role.sh).
# Runtime API se připojuje jako APP_DB_USER (NOSUPERUSER NOBYPASSRLS).
POSTGRES_DB=azkotle
POSTGRES_USER=azkotle
POSTGRES_PASSWORD=                 # ≥ 24 znaků, generuj `openssl rand -base64 32`

# --- Application DB role (runtime, non-superuser) ---
# Tato role je vytvořená automaticky init scriptem při FRESH postgres volume,
# nebo ručně přes deploy/postgres/apply-app-role.sh pro EXISTUJÍCÍ volume.
# Bez tohoto rozdělení by API jelo jako superuser a obcházelo by RLS.
APP_DB_USER=azkotle_app
APP_DB_PASSWORD=                   # ≥ 24 znaků, generuj `openssl rand -base64 32`

# --- JWT ---
AZKOTLE_JWT_SECRET=                # ≥ 32 znaků, generuj `openssl rand -base64 48`

# --- Backblaze B2 (S3 kompatibilní storage) ---
STORAGE_BUCKET=azkotle-prod
STORAGE_SERVICE_URL=https://s3.eu-central-003.backblazeb2.com
STORAGE_REGION=eu-central-003
STORAGE_ACCESS_KEY=                # B2 application key id
STORAGE_SECRET_KEY=                # B2 application key secret

# --- Backups (může být separátní bucket) ---
BACKUP_BUCKET=azkotle-backups
BACKUP_PREFIX=backups/postgres
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 3 * * *              # denně 03:00 Europe/Prague

# --- Seq (centrální logging) ---
# Vygeneruj hash: docker run --rm datalust/seq config hash '<your-password>'
SEQ_ADMIN_PASSWORD_HASH=
# Optional API key pro write — vytvoří se v Seq UI (Settings → API Keys).
# Pokud prázdné, app/api logují bez auth (Seq musí povolit anonymous ingest).
SEQ_API_KEY=

# --- Email provider ---
# Mail:Provider rozhoduje, který IEmailSender se zaregistruje (smtp | resend).
# Default "smtp" (Forpsi mailbox přes MailKit). "resend" pro cloud SaaS variant.
MAIL_PROVIDER=smtp

# From adresa pro transactional emaily. U SMTP musí odpovídat schránce.
MAIL_FROM=noreply@az-kotle.cz

# Veřejná base URL frontendu — slouží k sestavení odkazů v emailech
# (např. /reset-password?token=...). Bez koncového /.
APP_BASE_URL=https://www.az-kotle.cz

# --- SMTP (pokud MAIL_PROVIDER=smtp) ---
# Forpsi výchozí: smtp.forpsi.com:465 (implicit SSL).
SMTP_HOST=smtp.forpsi.com
SMTP_PORT=465
SMTP_USER=noreply@az-kotle.cz
SMTP_PASSWORD=                 # heslo k mailboxu, drž jen na VPS
SMTP_USE_SSL=true              # true = port 465 implicit SSL, false = 587 STARTTLS

# --- Resend (pokud MAIL_PROVIDER=resend) ---
# Vygeneruj v Resend dashboardu (https://resend.com/api-keys).
# Hodnota začíná `re_...`. Neumísťuj do gitu — drž jen na VPS v .env.prod.
RESEND_API_KEY=

# --- Image tag (přepisuje GitHub Actions deploy) ---
AZKOTLE_IMAGE_TAG=latest
