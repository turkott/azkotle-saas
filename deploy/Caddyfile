# Caddy reverse proxy pro AZ KOTLE production.
# Auto-HTTPS přes Let's Encrypt (vyžaduje DNS A/AAAA záznamy směřující na VPS).

{
    # Globální options.
    email admin@az-kotle.cz
    servers {
        protocols h1 h2 h3
    }
}

# --- Web (Blazor) — primary on www, app. zachován jako alias pro staré bookmarky ---
www.az-kotle.cz, app.az-kotle.cz {
    encode zstd gzip

    @metrics path /metrics
    handle @metrics {
        respond "Forbidden" 403 {
            close
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), camera=(), microphone=()"
        -Server
    }

    reverse_proxy app:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}

# --- API ---
api.az-kotle.cz {
    encode zstd gzip

    @metrics path /metrics
    handle @metrics {
        respond "Forbidden" 403 {
            close
        }
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        -Server
    }

    reverse_proxy api:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}

# --- Apex redirect → www. ---
az-kotle.cz {
    redir https://www.az-kotle.cz{uri} permanent
}
