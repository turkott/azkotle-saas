# syntax=docker/dockerfile:1.7
# Multi-stage build for AzKotle.Web (.NET 10 Blazor Web App s WASM klientem).
# Build context: repo root.
#
# Build:   docker build -f deploy/Dockerfile.web -t azkotle-web .
# Run:     docker run --rm -p 8081:8080 azkotle-web
#
# Pozn.: NEpoužíváme alpine/musl variantu (na rozdíl od Dockerfile.api),
# protože Blazor WASM vyžaduje Microsoft.NETCore.App.Runtime.Mono.linux-*-x64,
# který pro .NET 10 zatím není pro linux-musl-x64 (jen linux-x64 = Debian).
# Image je proto větší (~210 MB vs ~120 MB), ale runtime stejně rychlé.

ARG DOTNET_VERSION=10.0

FROM mcr.microsoft.com/dotnet/sdk:${DOTNET_VERSION} AS build
WORKDIR /src

# Restore.
COPY Directory.Packages.props Directory.Build.targets ./
COPY src/AzKotle.Application/AzKotle.Application.csproj src/AzKotle.Application/
COPY src/AzKotle.Domain/AzKotle.Domain.csproj         src/AzKotle.Domain/
COPY src/AzKotle.Infrastructure/AzKotle.Infrastructure.csproj src/AzKotle.Infrastructure/
COPY src/AzKotle.Shared/AzKotle.Shared.csproj          src/AzKotle.Shared/
COPY src/AzKotle.Web/AzKotle.Web.csproj                src/AzKotle.Web/
COPY src/AzKotle.Web.Client/AzKotle.Web.Client.csproj  src/AzKotle.Web.Client/
RUN dotnet restore src/AzKotle.Web/AzKotle.Web.csproj

# Build + publish.
COPY src/ src/
RUN dotnet publish src/AzKotle.Web/AzKotle.Web.csproj \
    -c Release \
    --no-restore \
    --self-contained false \
    -p:PublishReadyToRun=false \
    -o /app/publish

# Final runtime image (debian-based, kvůli kompatibilitě s WASM Mono).
FROM mcr.microsoft.com/dotnet/aspnet:${DOTNET_VERSION} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -r azkotle \
    && useradd -r -g azkotle -u 10001 azkotle
ENV TZ=Europe/Prague \
    DOTNET_RUNNING_IN_CONTAINER=true \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production

WORKDIR /app
COPY --from=build --chown=azkotle:azkotle /app/publish ./
USER azkotle
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENTRYPOINT ["dotnet", "AzKotle.Web.dll"]
